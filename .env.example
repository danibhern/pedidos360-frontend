# ============================================================
# PEDIDOS360 — FRONTEND REACT + VITE
# ============================================================
#
# Copia este archivo como ".env" antes de ejecutar el proyecto:
#
# Windows PowerShell:
# Copy-Item .env.example .env
#
# Después instala y ejecuta:
# npm install
# npm run dev -- --port 5173
#
# IMPORTANTE:
# - No subas el archivo .env al repositorio.
# - Nunca coloques claves, secretos, contraseñas ni JWTs aquí.
# - Las variables VITE_* quedan expuestas en el navegador.
# ============================================================

# Microsoft Entra ID — aplicación SPA
VITE_AZURE_CLIENT_ID=REEMPLAZAR_CON_CLIENT_ID_DEL_FRONTEND
VITE_AZURE_TENANT_ID=REEMPLAZAR_CON_TENANT_ID
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# AWS API Gateway + Microsoft Entra ID
VITE_API_BASE_URL=REEMPLAZAR_CON_URL_DE_API_GATEWAY
VITE_API_SCOPE=api://REEMPLAZAR_CON_API_CLIENT_ID/orders.read